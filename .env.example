# --- api ---
PORT=8787
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# --- auth ---
# Signs session cookies. Generate a real one for production:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
BETTER_AUTH_SECRET=dev-only-secret-not-for-production-use-32+

# Optional. Social sign-in is only enabled when BOTH are set, so a fresh clone
# runs without anyone creating a GitHub OAuth app.
# Callback URL: http://localhost:5173/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- database (matches docker-compose.yml) ---
DATABASE_URL=postgres://openrecipe:openrecipe@localhost:5432/openrecipe

# --- object storage (MinIO locally, R2/S3 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=openrecipe-media
S3_ACCESS_KEY=openrecipe
S3_SECRET_KEY=openrecipe-dev-secret
