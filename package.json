{
  "name": "openskillet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n core,api,web -c magenta,cyan,green \"npm:dev:core\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:core": "npm run dev -w @openskillet/core",
    "dev:api": "npm run dev -w @openskillet/api",
    "dev:web": "npm run dev -w @openskillet/web",
    "build": "tsc -b packages/core apps/api && npm run build -w @openskillet/web",
    "typecheck": "npm run typecheck -w @openskillet/core && npm run typecheck -w @openskillet/api && npm run typecheck -w @openskillet/web",
    "test": "npm run test -w @openskillet/core && npm run test -w @openskillet/api && npm run test -w @openskillet/web",
    "test:e2e": "playwright test",
    "clean": "tsc -b --clean packages/core apps/api && rm -rf apps/web/dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @openskillet/api",
    "db:migrate": "npm run db:migrate -w @openskillet/api",
    "db:studio": "npm run db:studio -w @openskillet/api",
    "db:backfill": "npm run db:backfill -w @openskillet/api",
    "db:password": "npm run db:password -w @openskillet/api --",
    "db:sweep-media": "npm run db:sweep-media -w @openskillet/api --",
    "db:seed": "npm run db:seed -w @openskillet/api --",
    "import:notion": "npm run import:notion -w @openskillet/api --",
    "import:urls": "npm run import:urls -w @openskillet/api --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
