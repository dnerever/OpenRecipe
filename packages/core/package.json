{
  "name": "@openrecipe/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "node-diff3": "^3.2.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  }
}
