{
  "name": "@openrecipe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --env-file-if-exists=../../.env --import ./src/test-guard.ts \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "tsc -b --clean",
    "db:backfill": "node --env-file-if-exists=../../.env src/db/backfill-caches.ts",
    "db:password": "node --env-file-if-exists=../../.env src/db/set-password.ts",
    "db:sweep-media": "node --env-file-if-exists=../../.env src/db/sweep-media.ts",
    "import:notion": "node --env-file-if-exists=../../.env src/import/import-notion.ts",
    "import:urls": "node --env-file-if-exists=../../.env src/import/import-urls.ts",
    "build": "tsc -b",
    "db:seed": "node --env-file-if-exists=../../.env src/seed/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@hono/node-server": "^2.1.5",
    "@openrecipe/core": "*",
    "@sentry/node": "^10.75.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.5",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
