# --- api ---
PORT=8787
NODE_ENV=development
APP_URL=http://localhost:5173

# --- auth ---
# Signs session cookies. Generate a real one for production:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
BETTER_AUTH_SECRET=dev-only-secret-not-for-production-use-32+

# Optional. Social sign-in is only enabled when BOTH are set, so a fresh clone
# runs without anyone creating a GitHub OAuth app.
# Callback URL: http://localhost:5173/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- database (matches docker-compose.yml) ---
DATABASE_URL=postgres://openrecipe:openrecipe@localhost:5432/openrecipe

# --- object storage (RustFS locally, R2/S3 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=openrecipe-media
S3_ACCESS_KEY=openrecipe
S3_SECRET_KEY=openrecipe-dev-secret

# --- outbound mail (Resend) ---
# Optional. Without it, a password reset link is logged to the console instead
# of emailed, so the flow still works on a fresh clone with no Resend account.
# RESEND_API_KEY=
# MAIL_FROM=OpenSkillet <onboarding@resend.dev>

# --- bot protection & rate limits ---
# Optional, both or neither. With both set, sign-up, sign-in, password reset and
# code requests require a Cloudflare Turnstile token, verified server-side.
# Unset, the check is skipped. The site key is public; it reaches the browser
# through /api/health, so no rebuild is needed to change it.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Which header carries the real client address, for per-IP rate limits. Default
# is x-forwarded-for (last hop). Behind Cloudflare's proxy use cf-connecting-ip.
# CLIENT_IP_HEADER=x-forwarded-for

# --- moderation ---
# Optional, comma-separated. Nobody is an admin with this unset; the /admin
# reports queue 404s for everyone rather than opening up.
# ADMIN_EMAILS=you@example.com

# --- error monitoring & analytics ---
# All three optional. SENTRY_DSN is the API's own project; VITE_SENTRY_DSN is
# the browser's — Sentry projects are per-platform, so these are normally two
# different DSNs even on the same Sentry account. Unset, errors just log to
# the console/browser devtools instead, same as every other integration here.
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# Optional. The whole per-site script URL Plausible's dashboard generates
# (Settings -> Installation -> Script), e.g. https://plausible.io/js/pa-
# <id>.js — turns on its cookie-free analytics for real browser visits only,
# unset, the app just doesn't load it.
# VITE_PLAUSIBLE_SCRIPT_SRC=
